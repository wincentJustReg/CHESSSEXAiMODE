import sys
import os
from enum import Enum

import mss
from stockfish import Stockfish

from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QPushButton, QLabel,
    QVBoxLayout, QHBoxLayout, QSlider, QMessageBox
)
from PyQt5.QtCore import Qt, QTimer, QPointF, pyqtSignal, QPoint
from PyQt5.QtGui import QPainter, QColor, QPen, QFont, QPolygonF


# ================== КОНСТАНТЫ ==================
VERSION = "14.2"
STOCKFISH_PATH = r"E:\pythonchessSEXXD\stockfish\stockfish-windows-x86-64-avx2.exe"


# ================== VISION ==================
class ChessVision:
    def __init__(self):
        self.stockfish = None
        self.player_color = "white"

    def init_stockfish(self):
        try:
            if not os.path.exists(STOCKFISH_PATH):
                print("❌ Stockfish не найден")
                return False
            self.stockfish = Stockfish(path=STOCKFISH_PATH)
            self.stockfish.set_depth(22)
            self.stockfish.set_skill_level(20)
            print("✅ Stockfish готов!")
            return True
        except Exception as e:
            print(f"❌ Stockfish: {e}")
            return False

    def get_best_move(self):
        if not self.stockfish:
            return "e2e4"
        try:
            fen = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR b KQkq - 0 1" if self.player_color == "black" else \
                  "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
            self.stockfish.set_fen_position(fen)
            return self.stockfish.get_best_move()
        except:
            return "e2e4"


# ================== VISION WINDOW ==================
class VisionWindow(QMainWindow):
    def __init__(self, vision):
        super().__init__()
        self.vision = vision
        self.current_move = "e2e4"
        self.player_color = "white"
        self.locked = False
        self.drag_pos = None

        self.setWindowTitle("Chess Vision")
        self.setGeometry(400, 150, 900, 900)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool)
        self.setWindowOpacity(0.88)

    def mousePressEvent(self, event):
        if not self.locked and event.button() == Qt.LeftButton:
            self.drag_pos = event.globalPos() - self.pos()

    def mouseMoveEvent(self, event):
        if self.drag_pos and not self.locked:
            self.move(event.globalPos() - self.drag_pos)

    def mouseReleaseEvent(self, event):
        self.drag_pos = None

    def update_position(self, move, color):
        self.current_move = move
        self.player_color = color
        self.update()

    def set_locked(self, locked: bool):
        self.locked = locked
        if locked:
            # Делаем окно прозрачным для кликов
            self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool | Qt.WindowTransparentForInput)
            self.setWindowOpacity(0.65)
        else:
            self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool)
            self.setWindowOpacity(0.88)
        self.show()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)

        painter.fillRect(self.rect(), QColor(0, 0, 0, 30))

        # Малиновый неон
        neon_color = QColor(255, 20, 147)  # Deep Pink / Малиновый
        neon_pen = QPen(neon_color, 5)
        painter.setPen(neon_pen)
        painter.drawRect(10, 10, self.width()-20, self.height()-20)

        # Стрелка (более заметная и красивая)
        arrow_color = QColor(255, 50, 180, 230)
        pen = QPen(arrow_color, 9, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin)
        painter.setPen(pen)

        # Стрелка от центра левой части в правую
        start = QPointF(self.width() * 0.28, self.height() * 0.48)
        end = QPointF(self.width() * 0.78, self.height() * 0.65)
        painter.drawLine(start, end)

        # Большой наконечник
        arrow_size = 32
        dx = end.x() - start.x()
        dy = end.y() - start.y()
        length = (dx**2 + dy**2)**0.5
        ux, uy = dx / length, dy / length

        p1 = QPointF(end.x() - arrow_size * (ux * 0.8 - uy * 0.8), end.y() - arrow_size * (uy * 0.8 + ux * 0.8))
        p2 = QPointF(end.x() - arrow_size * (ux * 0.8 + uy * 0.8), end.y() - arrow_size * (uy * 0.8 - ux * 0.8))

        painter.setBrush(arrow_color)
        painter.drawPolygon([end, p1, p2])

        # Текст
        painter.setPen(QColor(255, 255, 255, 250))
        painter.setFont(QFont("Arial", 17, QFont.Bold))
        side = "БЕЛЫХ" if self.player_color == "white" else "ЧЁРНЫХ"
        painter.drawText(45, 85, f"ХОД ДЛЯ {side}: {self.current_move.upper()}")


# ================== CONTROL WINDOW ==================
class ControlWindow(QMainWindow):
    def __init__(self, vision, vision_window):
        super().__init__()
        self.vision = vision
        self.vision_window = vision_window
        self.locked = False
        self.init_ui()

    def init_ui(self):
        self.setWindowTitle("Control")
        self.setGeometry(80, 120, 460, 340)
        self.setStyleSheet("background: #0A0A0A; color: #EEEEEE;")

        central = QWidget()
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)
        layout.setContentsMargins(25, 25, 25, 25)
        layout.setSpacing(18)

        title = QLabel("♟ CHESS CHAMS ULTIMATE")
        title.setFont(QFont("Arial", 15, QFont.Bold))
        title.setStyleSheet("color: #FF1493;")  # Малиновый
        layout.addWidget(title)

        self.color_toggle = ColorToggle()
        self.color_toggle.color_changed.connect(self.change_color)
        layout.addWidget(self.color_toggle)

        btn_layout = QHBoxLayout()
        self.btn_lock = QPushButton("🔒 ЗАБЛОКИРОВАТЬ ВИЖН")
        self.btn_analyze = QPushButton("📸 АНАЛИЗ")
        self.btn_close = QPushButton("❌ ВЫХОД")

        for btn in (self.btn_lock, self.btn_analyze, self.btn_close):
            btn.setFixedHeight(50)
            btn.setStyleSheet("font-size: 14px; font-weight: bold;")

        self.btn_lock.clicked.connect(self.toggle_lock)
        self.btn_analyze.clicked.connect(self.manual_analyze)
        self.btn_close.clicked.connect(self.close_all)

        btn_layout.addWidget(self.btn_lock)
        btn_layout.addWidget(self.btn_analyze)
        btn_layout.addWidget(self.btn_close)
        layout.addLayout(btn_layout)

        # Слайдеры
        for name, attr in [("Ширина", "w"), ("Высота", "h")]:
            lbl = QLabel(name + ":")
            slider = QSlider(Qt.Horizontal)
            slider.setRange(600, 1600)
            slider.setValue(900)
            slider.valueChanged.connect(self.resize_vision)
            setattr(self, f"slider_{attr}", slider)
            layout.addWidget(lbl)
            layout.addWidget(slider)

    def change_color(self, color):
        self.vision.player_color = color

    def toggle_lock(self):
        self.locked = not self.locked
        self.vision_window.set_locked(self.locked)
        self.btn_lock.setText("🔓 РАЗБЛОКИРОВАТЬ" if self.locked else "🔒 ЗАБЛОКИРОВАТЬ ВИЖН")

        if self.locked:
            self.timer = QTimer()
            self.timer.timeout.connect(self.auto_update)
            self.timer.start(1600)
        elif hasattr(self, 'timer'):
            self.timer.stop()

    def resize_vision(self):
        w = self.slider_w.value()
        h = self.slider_h.value()
        self.vision_window.resize(w, h)

    def manual_analyze(self):
        move = self.vision.get_best_move()
        self.vision_window.update_position(move, self.vision.player_color)

    def auto_update(self):
        move = self.vision.get_best_move()
        self.vision_window.update_position(move, self.vision.player_color)

    def close_all(self):
        if QMessageBox.question(self, "Выход", "Закрыть всё?") == QMessageBox.Yes:
            self.vision_window.close()
            self.close()


# ================== ТОГГЛ ==================
class ColorToggle(QWidget):
    color_changed = pyqtSignal(str)

    def __init__(self):
        super().__init__()
        self.setFixedSize(210, 52)
        self.is_white = True

    def mousePressEvent(self, event):
        self.is_white = not self.is_white
        self.color_changed.emit("white" if self.is_white else "black")
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)

        painter.setBrush(QColor(25, 25, 25))
        painter.drawRoundedRect(0, 0, self.width(), self.height(), 26, 26)

        circle_x = 10 if self.is_white else self.width() - 42
        painter.setBrush(QColor(255, 20, 147))
        painter.drawEllipse(circle_x, 11, 32, 32)

        painter.setPen(Qt.white)
        painter.setFont(QFont("Arial", 12, QFont.Bold))
        text = "⚪ БЕЛЫЕ" if self.is_white else "⚫ ЧЁРНЫЕ"
        painter.drawText(55 if self.is_white else 18, 34, text)


# ================== ЗАПУСК ==================
def main():
    print("=" * 100)
    print(f"♟ CHESS CHAMS ULTIMATE v{VERSION}")
    print("=" * 100)

    app = QApplication(sys.argv)
    
    vision = ChessVision()
    vision.init_stockfish()

    vision_win = VisionWindow(vision)
    control_win = ControlWindow(vision, vision_win)

    vision_win.show()
    control_win.show()

    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
