#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
CHESS CHAMS ULTIMATE - V16.8 "ГАЛОЧКИ ИСПРАВЛЕНЫ"
"""

import sys
import os
import json
import numpy as np
import cv2
import mss
from stockfish import Stockfish

from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QPushButton, QLabel,
    QVBoxLayout, QHBoxLayout, QSlider, QMessageBox, QGridLayout
)
from PyQt5.QtCore import Qt, QTimer, QPoint, pyqtSignal
from PyQt5.QtGui import QPainter, QColor, QPen, QFont


VERSION = "16.8"
STOCKFISH_PATH = r"E:\pythonchessSEXXD\stockfish\stockfish-windows-x86-64-avx2.exe"
CONFIG_FILE = "chess_calib_config.json"


class ChessVision:
    def __init__(self):
        self.stockfish = None
        self.player_color = "white"
        self.sct = mss.MSS()
        
        self.config = {
            "light_square": "#F0F0F0",
            "dark_square": "#8C8C8C",
            "white_piece": "#FFFFFF",
            "black_piece": "#282828"
        }
        self.load_config()

    def init_stockfish(self):
        try:
            if not os.path.exists(STOCKFISH_PATH):
                print("❌ Stockfish не найден")
                return False
            self.stockfish = Stockfish(path=STOCKFISH_PATH)
            self.stockfish.set_depth(20)
            self.stockfish.set_skill_level(20)
            print("✅ Stockfish готов!")
            return True
        except Exception as e:
            print(f"❌ Stockfish: {e}")
            return False

    def load_config(self):
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, 'r') as f:
                    self.config = json.load(f)
                print("✅ Загружена калибровка")
            except:
                pass

    def save_config(self):
        try:
            with open(CONFIG_FILE, 'w') as f:
                json.dump(self.config, f, indent=2)
            print("💾 Сохранено")
            return True
        except:
            return False

    def capture_board(self, vision_window):
        try:
            geo = vision_window.geometry()
            monitor = {"top": geo.y(), "left": geo.x(), "width": geo.width(), "height": geo.height()}
            screenshot = self.sct.grab(monitor)
            img = np.array(screenshot)
            img = cv2.cvtColor(img, cv2.COLOR_BGRA2BGR)
            return img
        except:
            return None

    def get_color_at(self, vision_window, x, y):
        img = self.capture_board(vision_window)
        if img is None:
            return "#808080"
        h, w = img.shape[:2]
        x = max(0, min(x, w-1))
        y = max(0, min(y - 12, h-1))   # выше галочки
        b, g, r = img[y, x]
        return f"#{r:02X}{g:02X}{b:02X}"


# ================== VISION WINDOW ==================
class VisionWindow(QMainWindow):
    def __init__(self, vision):
        super().__init__()
        self.vision = vision
        self.locked = False
        self.drag_pos = None
        self.show_markers = False

        self.markers = {
            "light_square": QPoint(250, 250),
            "dark_square": QPoint(350, 250),
            "white_piece": QPoint(450, 450),
            "black_piece": QPoint(550, 450)
        }
        self.dragging_marker = None

        self.setWindowTitle("Chess Vision - НАКРОЙ ДОСКУ")
        self.setGeometry(400, 150, 900, 900)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool)
        self.setWindowOpacity(0.78)

    def show_calibration_markers(self, show: bool):
        self.show_markers = show
        self.update()

    def mousePressEvent(self, event):
        if self.locked:
            return
        pos = event.pos()
        for key, mpos in self.markers.items():
            if (pos - mpos).manhattanLength() < 35:
                self.dragging_marker = key
                return
        if event.button() == Qt.LeftButton:
            self.drag_pos = event.globalPos() - self.pos()

    def mouseMoveEvent(self, event):
        if self.dragging_marker:
            self.markers[self.dragging_marker] = event.pos()
            self.update()
        elif self.drag_pos and not self.locked:
            self.move(event.globalPos() - self.drag_pos)

    def mouseReleaseEvent(self, event):
        self.dragging_marker = None
        self.drag_pos = None

    def set_locked(self, locked: bool):
        self.locked = locked
        if locked:
            flags = Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool | Qt.WindowTransparentForInput
            self.setWindowFlags(flags)
            self.setWindowOpacity(0.58)
        else:
            flags = Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool
            self.setWindowFlags(flags)
            self.setWindowOpacity(0.78)
        self.show()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        painter.fillRect(self.rect(), QColor(0, 0, 0, 35))

        neon_color = QColor(255, 140, 0)
        painter.setPen(QPen(neon_color, 6))
        painter.drawRect(12, 12, self.width()-24, self.height()-24)

        if not self.show_markers:
            return

        marker_info = {
            "light_square": (Qt.yellow, "СВЕТЛАЯ КЛЕТКА"),
            "dark_square": (Qt.cyan, "ТЁМНАЯ КЛЕТКА"),
            "white_piece": (Qt.white, "БЕЛАЯ ФИГУРА"),
            "black_piece": (Qt.red, "ЧЁРНАЯ ФИГУРА")
        }

        for key, pos in self.markers.items():
            color, label = marker_info[key]
            
            # Перевёрнутая галочка /\
            painter.setPen(QPen(color, 5))
            painter.drawLine(pos.x() - 24, pos.y() + 20, pos.x(), pos.y() - 20)
            painter.drawLine(pos.x(), pos.y() - 20, pos.x() + 24, pos.y() + 20)

            painter.setPen(QPen(Qt.white, 2))
            painter.setFont(QFont("Arial", 9, QFont.Bold))
            painter.drawText(pos.x() + 32, pos.y() + 8, label)


# ================== CONTROL WINDOW ==================
class ControlWindow(QMainWindow):
    def __init__(self, vision, vision_window):
        super().__init__()
        self.vision = vision
        self.vision_window = vision_window
        self.locked = False
        self.init_ui()

    def init_ui(self):
        self.setWindowTitle("Control")
        self.setGeometry(80, 120, 540, 720)
        self.setWindowFlags(Qt.WindowStaysOnTopHint)
        self.setStyleSheet("background: #0A0A0A; color: #EEEEEE;")

        central = QWidget()
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)
        layout.setContentsMargins(25, 25, 25, 25)
        layout.setSpacing(15)

        title = QLabel(f"♟ CHESS CHAMS ULTIMATE v{VERSION}")
        title.setFont(QFont("Arial", 14, QFont.Bold))
        title.setStyleSheet("color: #FF8C00;")
        layout.addWidget(title)

        grid = QGridLayout()
        self.previews = {}
        items = [
            ("Светлая клетка", "light_square"),
            ("Тёмная клетка", "dark_square"),
            ("Белая фигура", "white_piece"),
            ("Чёрная фигура", "black_piece")
        ]

        for i, (text, key) in enumerate(items):
            lbl = QLabel(text)
            grid.addWidget(lbl, i, 0)

            preview = QLabel()
            preview.setFixedSize(60, 60)
            color = self.vision.config[key]
            preview.setStyleSheet(f"background-color: {color}; border: 3px solid #FF8C00; border-radius: 8px;")
            grid.addWidget(preview, i, 1)
            self.previews[key] = preview

        layout.addLayout(grid)

        self.btn_start_calib = QPushButton("🔧 НАЧАТЬ КАЛИБРОВКУ")
        self.btn_start_calib.clicked.connect(self.start_calibration)
        layout.addWidget(self.btn_start_calib)

        self.btn_update = QPushButton("🔄 ОБНОВИТЬ ЦВЕТА ИЗ ГАЛОЧЕК")
        self.btn_update.clicked.connect(self.update_colors_from_markers)
        layout.addWidget(self.btn_update)

        btn_layout = QHBoxLayout()
        self.btn_lock = QPushButton("🔒 ЗАБЛОКИРОВАТЬ + АНАЛИЗ")
        self.btn_analyze = QPushButton("📸 РАЗОВЫЙ АНАЛИЗ")
        self.btn_close = QPushButton("❌ ВЫХОД")

        for btn in (self.btn_lock, self.btn_analyze, self.btn_close):
            btn.setFixedHeight(50)

        self.btn_lock.clicked.connect(self.toggle_lock)
        self.btn_analyze.clicked.connect(self.manual_analyze)
        self.btn_close.clicked.connect(self.close_all)

        btn_layout.addWidget(self.btn_lock)
        btn_layout.addWidget(self.btn_analyze)
        btn_layout.addWidget(self.btn_close)
        layout.addLayout(btn_layout)

        for name, attr in [("Ширина Vision", "w"), ("Высота Vision", "h")]:
            lbl = QLabel(name + ":")
            slider = QSlider(Qt.Horizontal)
            slider.setRange(600, 1600)
            slider.setValue(900)
            slider.valueChanged.connect(self.resize_vision)
            setattr(self, f"slider_{attr}", slider)
            layout.addWidget(lbl)
            layout.addWidget(slider)

        self.hint_label = QLabel("Нажми 'НАЧАТЬ КАЛИБРОВКУ'")
        self.hint_label.setFont(QFont("Arial", 15))
        self.hint_label.setStyleSheet("color: #FFAA00; background: #1F1F1F; padding: 15px; border-radius: 8px;")
        self.hint_label.setWordWrap(True)
        layout.addWidget(self.hint_label)

    def start_calibration(self):
        self.vision_window.show_calibration_markers(True)
        self.hint_label.setText("Перетащи галочки на нужные места → нажми 'ОБНОВИТЬ ЦВЕТА'")

    def update_colors_from_markers(self):
        try:
            for key, pos in self.vision_window.markers.items():
                color_hex = self.vision.get_color_at(self.vision_window, pos.x(), pos.y())
                self.vision.config[key] = color_hex
                self.previews[key].setStyleSheet(
                    f"background-color: {color_hex}; border: 3px solid #FF8C00; border-radius: 8px;"
                )
            if self.vision.save_config():
                self.hint_label.setText("✅ Цвета обновлены! Галочки скрыты.")
                self.vision_window.show_calibration_markers(False)
        except Exception as e:
            self.hint_label.setText(f"❌ Ошибка: {e}")

    def change_color(self, color):
        self.vision.player_color = color

    def toggle_lock(self):
        self.locked = not self.locked
        self.vision_window.set_locked(self.locked)
        self.btn_lock.setText("🔓 РАЗБЛОКИРОВАТЬ" if self.locked else "🔒 ЗАБЛОКИРОВАТЬ + АНАЛИЗ")

        if self.locked:
            self.timer = QTimer()
            self.timer.timeout.connect(self.auto_update)
            self.timer.start(2200)
        elif hasattr(self, 'timer'):
            self.timer.stop()

    def resize_vision(self):
        w = self.slider_w.value()
        h = self.slider_h.value()
        self.vision_window.resize(w, h)

    def manual_analyze(self):
        self.hint_label.setText("Анализ пока в разработке...")

    def auto_update(self):
        self.manual_analyze()

    def close_all(self):
        if QMessageBox.question(self, "Выход", "Закрыть всё?") == QMessageBox.Yes:
            self.vision_window.close()
            self.close()


class ColorToggle(QWidget):
    color_changed = pyqtSignal(str)

    def __init__(self):
        super().__init__()
        self.setFixedSize(210, 52)
        self.is_white = True

    def mousePressEvent(self, event):
        self.is_white = not self.is_white
        self.color_changed.emit("white" if self.is_white else "black")
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        painter.setBrush(QColor(25, 25, 25))
        painter.drawRoundedRect(0, 0, self.width(), self.height(), 26, 26)

        circle_x = 10 if self.is_white else self.width() - 42
        painter.setBrush(QColor(255, 140, 0))
        painter.drawEllipse(circle_x, 11, 32, 32)

        painter.setPen(Qt.white)
        painter.setFont(QFont("Arial", 12, QFont.Bold))
        text = "⚪ БЕЛЫЕ" if self.is_white else "⚫ ЧЁРНЫЕ"
        painter.drawText(55 if self.is_white else 18, 34, text)


def main():
    print("=" * 100)
    print(f"♟ CHESS CHAMS ULTIMATE v{VERSION}")
    print("=" * 100)

    app = QApplication(sys.argv)
    
    vision = ChessVision()
    vision.init_stockfish()

    vision_win = VisionWindow(vision)
    control_win = ControlWindow(vision, vision_win)

    vision_win.show()
    control_win.show()

    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
