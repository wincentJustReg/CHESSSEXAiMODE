#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
CHESS CHAMS ULTIMATE - V15.2 "ПОДСКАЗКА В CONTROL"
"""

import sys
import os
import numpy as np
import cv2
import mss
from stockfish import Stockfish

from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QPushButton, QLabel,
    QVBoxLayout, QHBoxLayout, QSlider, QMessageBox
)
from PyQt5.QtCore import Qt, QTimer, pyqtSignal
from PyQt5.QtGui import QPainter, QColor, QPen, QFont


# ================== КОНСТАНТЫ ==================
VERSION = "15.2"
STOCKFISH_PATH = r"E:\pythonchessSEXXD\stockfish\stockfish-windows-x86-64-avx2.exe"


class ChessVision:
    def __init__(self):
        self.stockfish = None
        self.player_color = "white"
        self.sct = mss.MSS()

    def init_stockfish(self):
        try:
            if not os.path.exists(STOCKFISH_PATH):
                print("❌ Stockfish не найден")
                return False
            self.stockfish = Stockfish(path=STOCKFISH_PATH)
            self.stockfish.set_depth(20)
            self.stockfish.set_skill_level(20)
            print("✅ Stockfish готов!")
            return True
        except Exception as e:
            print(f"❌ Stockfish: {e}")
            return False

    def capture_board(self, vision_window):
        try:
            geo = vision_window.geometry()
            monitor = {"top": geo.y(), "left": geo.x(), "width": geo.width(), "height": geo.height()}
            screenshot = self.sct.grab(monitor)
            img = np.array(screenshot)
            img = cv2.cvtColor(img, cv2.COLOR_BGRA2BGR)
            return img
        except Exception as e:
            print(f"Ошибка захвата: {e}")
            return None

    def detect_chessboard(self, img):
        if img is None:
            return None

        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
        blur = cv2.GaussianBlur(gray, (5, 5), 0)
        edges = cv2.Canny(blur, 50, 150)

        lines = cv2.HoughLinesP(edges, 1, np.pi/180, 100, minLineLength=100, maxLineGap=20)
        
        if lines is None:
            print("❌ Линии доски не найдены")
            cv2.imwrite("debug_edges.png", edges)
            return None

        print(f"✅ Найдено {len(lines)} линий")
        cv2.imwrite("debug_edges.png", edges)
        return "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"

    def detect_position(self, vision_window):
        img = self.capture_board(vision_window)
        if img is None:
            return None
        
        cv2.imwrite("debug_board.png", img)
        fen = self.detect_chessboard(img)
        print("📊 Позиция захвачена")
        return fen or "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"

    def get_best_move(self, fen=None):
        if not self.stockfish:
            return "e2e4"
        try:
            if fen:
                self.stockfish.set_fen_position(fen)
            return self.stockfish.get_best_move()
        except Exception as e:
            print(f"Stockfish error: {e}")
            return "e2e4"


# ================== VISION WINDOW (чисто, без текста) ==================
class VisionWindow(QMainWindow):
    def __init__(self, vision):
        super().__init__()
        self.vision = vision
        self.locked = False
        self.drag_pos = None

        self.setWindowTitle("Chess Vision - НАКРОЙ ДОСКУ")
        self.setGeometry(400, 150, 900, 900)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool)
        self.setWindowOpacity(0.72)

    def mousePressEvent(self, event):
        if not self.locked and event.button() == Qt.LeftButton:
            self.drag_pos = event.globalPos() - self.pos()

    def mouseMoveEvent(self, event):
        if self.drag_pos and not self.locked:
            self.move(event.globalPos() - self.drag_pos)

    def mouseReleaseEvent(self, event):
        self.drag_pos = None

    def set_locked(self, locked: bool):
        self.locked = locked
        if locked:
            flags = Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool | Qt.WindowTransparentForInput
            self.setWindowFlags(flags)
            self.setWindowOpacity(0.58)
        else:
            flags = Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool
            self.setWindowFlags(flags)
            self.setWindowOpacity(0.72)
        self.show()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)

        painter.fillRect(self.rect(), QColor(0, 0, 0, 40))

        # Только неоновая рамка
        neon_color = QColor(255, 140, 0)
        painter.setPen(QPen(neon_color, 6))
        painter.drawRect(12, 12, self.width()-24, self.height()-24)


# ================== CONTROL WINDOW ==================
class ControlWindow(QMainWindow):
    def __init__(self, vision, vision_window):
        super().__init__()
        self.vision = vision
        self.vision_window = vision_window
        self.locked = False
        self.init_ui()

    def init_ui(self):
        self.setWindowTitle("Control")
        self.setGeometry(80, 120, 480, 520)  # увеличил высоту
        self.setWindowFlags(Qt.WindowStaysOnTopHint)
        self.setStyleSheet("background: #0A0A0A; color: #EEEEEE;")

        central = QWidget()
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)
        layout.setContentsMargins(25, 25, 25, 25)
        layout.setSpacing(16)

        title = QLabel(f"♟ CHESS CHAMS ULTIMATE v{VERSION}")
        title.setFont(QFont("Arial", 14, QFont.Bold))
        title.setStyleSheet("color: #FF8C00;")
        layout.addWidget(title)

        self.color_toggle = ColorToggle()
        self.color_toggle.color_changed.connect(self.change_color)
        layout.addWidget(self.color_toggle)

        btn_layout = QHBoxLayout()
        self.btn_lock = QPushButton("🔒 ЗАБЛОКИРОВАТЬ + АНАЛИЗ")
        self.btn_analyze = QPushButton("📸 РАЗОВЫЙ АНАЛИЗ")
        self.btn_close = QPushButton("❌ ВЫХОД")

        for btn in (self.btn_lock, self.btn_analyze, self.btn_close):
            btn.setFixedHeight(50)

        self.btn_lock.clicked.connect(self.toggle_lock)
        self.btn_analyze.clicked.connect(self.manual_analyze)
        self.btn_close.clicked.connect(self.close_all)

        btn_layout.addWidget(self.btn_lock)
        btn_layout.addWidget(self.btn_analyze)
        btn_layout.addWidget(self.btn_close)
        layout.addLayout(btn_layout)

        # Ползунки
        for name, attr in [("Ширина Vision", "w"), ("Высота Vision", "h")]:
            lbl = QLabel(name + ":")
            slider = QSlider(Qt.Horizontal)
            slider.setRange(600, 1600)
            slider.setValue(900)
            slider.valueChanged.connect(self.resize_vision)
            setattr(self, f"slider_{attr}", slider)
            layout.addWidget(lbl)
            layout.addWidget(slider)

        # === ТЕКСТОВАЯ ПОДСКАЗКА ХОДА (снизу) ===
        self.hint_label = QLabel("Ожидание хода...")
        self.hint_label.setFont(QFont("Arial", 18, QFont.Bold))
        self.hint_label.setStyleSheet("""
            color: #FFAA00; 
            background: #1F1F1F; 
            padding: 15px; 
            border-radius: 8px;
            border: 2px solid #FF8C00;
        """)
        self.hint_label.setAlignment(Qt.AlignCenter)
        self.hint_label.setMinimumHeight(70)
        layout.addWidget(self.hint_label)

    def change_color(self, color):
        self.vision.player_color = color

    def toggle_lock(self):
        self.locked = not self.locked
        self.vision_window.set_locked(self.locked)
        self.btn_lock.setText("🔓 РАЗБЛОКИРОВАТЬ" if self.locked else "🔒 ЗАБЛОКИРОВАТЬ + АНАЛИЗ")

        if self.locked:
            self.timer = QTimer()
            self.timer.timeout.connect(self.auto_update)
            self.timer.start(1800)
        elif hasattr(self, 'timer'):
            self.timer.stop()

    def resize_vision(self):
        w = self.slider_w.value()
        h = self.slider_h.value()
        self.vision_window.resize(w, h)

    def update_hint(self, move, color):
        side = "БЕЛЫЕ" if color == "white" else "ЧЁРНЫЕ"
        text = f"{side} → {move.upper()}"
        self.hint_label.setText(text)

    def manual_analyze(self):
        fen = self.vision.detect_position(self.vision_window)
        move = self.vision.get_best_move(fen)
        self.update_hint(move, self.vision.player_color)

    def auto_update(self):
        fen = self.vision.detect_position(self.vision_window)
        move = self.vision.get_best_move(fen)
        self.update_hint(move, self.vision.player_color)

    def close_all(self):
        if QMessageBox.question(self, "Выход", "Закрыть всё?") == QMessageBox.Yes:
            self.vision_window.close()
            self.close()


class ColorToggle(QWidget):
    color_changed = pyqtSignal(str)

    def __init__(self):
        super().__init__()
        self.setFixedSize(210, 52)
        self.is_white = True

    def mousePressEvent(self, event):
        self.is_white = not self.is_white
        self.color_changed.emit("white" if self.is_white else "black")
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        painter.setBrush(QColor(25, 25, 25))
        painter.drawRoundedRect(0, 0, self.width(), self.height(), 26, 26)

        circle_x = 10 if self.is_white else self.width() - 42
        painter.setBrush(QColor(255, 140, 0))
        painter.drawEllipse(circle_x, 11, 32, 32)

        painter.setPen(Qt.white)
        painter.setFont(QFont("Arial", 12, QFont.Bold))
        text = "⚪ БЕЛЫЕ" if self.is_white else "⚫ ЧЁРНЫЕ"
        painter.drawText(55 if self.is_white else 18, 34, text)


# ================== ЗАПУСК ==================
def main():
    print("=" * 100)
    print(f"♟ CHESS CHAMS ULTIMATE v{VERSION} — ПОДСКАЗКА В CONTROL")
    print("=" * 100)
    print("Наведи Vision окно на доску и тестируй")

    app = QApplication(sys.argv)
    
    vision = ChessVision()
    vision.init_stockfish()

    vision_win = VisionWindow(vision)
    control_win = ControlWindow(vision, vision_win)

    vision_win.show()
    control_win.show()

    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
